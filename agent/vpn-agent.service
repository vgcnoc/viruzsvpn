[Unit]
Description=VPNOPS restricted control agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# WireGuard peer changes require CAP_NET_ADMIN. This unit is deliberately
# restricted to the fixed Python agent and fixed /usr/bin/wg commands.
User=root
Group=root
EnvironmentFile=/etc/vpnops-agent/agent.env
ExecStart=/usr/bin/python3 /opt/vpnops-agent/vpn_agent.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_DAC_OVERRIDE
ReadWritePaths=/etc/wireguard /var/lib/vpnops-agent

[Install]
WantedBy=multi-user.target
